---
import '../styles/jetons.css';
import '../styles/global.css';
import '../styles/shell.css';
import Seo from '../components/Seo.astro';
import Entete from '../components/Entete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import BandeauCookies from '../components/BandeauCookies.astro';
import FilAriane, { type Miette } from '../components/FilAriane.astro';
import { lireNavigation, lireParametres } from '../lib/contenus';
import { cssTheme, policesUtilisees } from '../lib/theme';
import { bandeauNecessaire, codesSuivi } from '../lib/suivi';
import { urlMedia, type Seo as SeoStrapi } from '../lib/strapi';

interface Props {
  titre?: string;
  description?: string;
  seo?: SeoStrapi | null;
  image?: string | null;
  type?: 'website' | 'article';
  noIndex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Fil d'Ariane (hors accueil). La dernière miette est la page courante. */
  ariane?: Miette[];
  /** Sans bandeau de cookies ni outils de mesure (aperçu des brouillons du BO). */
  sansSuivi?: boolean;
}

const { ariane, sansSuivi, ...seo } = Astro.props;
const [parametres, navigation] = await Promise.all([lireParametres(), lireNavigation()]);
const favicon = urlMedia(parametres.favicon, true);
const suivi = sansSuivi ? { head: [], body: [] } : codesSuivi(parametres);
// Bandeau dès qu'un outil attend l'accord du visiteur ; l'option « Toujours afficher le bandeau » du BO l'affiche aussi sans outil.
const bandeau = !sansSuivi && (bandeauNecessaire(suivi) || !!parametres.bandeauCookies);

// Fil d'Ariane : un en-tête de page immersif l'affiche dans son bandeau (voir EnTetePage) ; sinon il est placé en haut
// du contenu. La page est donc rendue avant la mise en page, pour savoir lequel des deux s'en charge.
Astro.locals.ariane = ariane;
Astro.locals.arianeAffichee = false;
const contenu = await Astro.slots.render('default');
const arianeEnHaut = ariane && !Astro.locals.arianeAffichee;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo parametres={parametres} {...seo} />
    {policesUtilisees(parametres).map((p) => <link rel="preload" href={p.url} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={cssTheme(parametres)}></style>
    {favicon ? <link rel="icon" href={favicon} /> : <link rel="icon" href="/favicon.svg" type="image/svg+xml" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {suivi.head.map((s) => (s.differe ? <template data-mjc-suivi="head" set:html={s.code} /> : <Fragment set:html={s.code} />))}
  </head>
  <body>
    {bandeau && <BandeauCookies texte={parametres.texteBandeauCookies} lien={parametres.lienPolitiqueCookies} gestmaxUrlFront={parametres.gestmaxUrlFront} />}
    <Entete parametres={parametres} navigation={navigation} />
    <main id="contenu" tabindex="-1">
      {arianeEnHaut && <FilAriane miettes={ariane} />}
      <Fragment set:html={contenu} />
    </main>
    <PiedDePage parametres={parametres} navigation={navigation} gestionCookies={bandeau} />
    {suivi.body.map((s) => (s.differe ? <template data-mjc-suivi="body" set:html={s.code} /> : <Fragment set:html={s.code} />))}
  </body>
</html>
