---
import Base from '../../layouts/Base.astro';
import EnTetePage from '../../components/EnTetePage.astro';
import CarteEvenement from '../../components/cartes/CarteEvenement.astro';
import { lireEvenements } from '../../lib/contenus';
import { formatDate } from '../../lib/format';

const tous = await lireEvenements();
const maintenant = Date.now();
const estPasse = (e: (typeof tous)[number]) => new Date(e.dateFin ?? e.dateDebut).getTime() < maintenant;
const aVenir = tous.filter((e) => !estPasse(e));
const types = [...new Set(aVenir.map((e) => e.typeEvenement))].sort((a, b) => a.localeCompare(b, 'fr'));
const passes = tous.filter(estPasse).reverse().slice(0, 12);
---

<Base titre="Événements" description="Forums, job datings, ateliers : les événements emploi du territoire." ariane={[{ libelle: 'Événements' }]}>
  <EnTetePage titre="Événements" chapo="Forums, job datings, ateliers, webinaires : rencontrez les recruteurs du territoire." />

  <section class="section" aria-labelledby="a-venir">
    <div class="conteneur">
      <h2 id="a-venir" class="section__titre section__titre--gauche">À venir</h2>
      {
        types.length > 1 && (
          <form class="filtres-liste" role="search" aria-label="Filtrer les événements" data-filtre-evenements hidden>
            <div class="recherche__champ">
              <label for="filtre-type">Type d'événement</label>
              <select id="filtre-type" name="type">
                <option value="">Tous les types</option>
                {types.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>
          </form>
        )
      }
      <p class="resultats" aria-live="polite" data-resultats-evenements hidden></p>
      {
        aVenir.length ? (
          <ul class="grille grille--3" data-liste-evenements>
            {aVenir.map((e) => (
              <li data-type={e.typeEvenement}><CarteEvenement evenement={e} /></li>
            ))}
          </ul>
        ) : (
          <p>Aucun événement programmé pour le moment. Revenez bientôt !</p>
        )
      }
    </div>
  </section>

  {
    passes.length > 0 && (
      <section class="section section--teinte" aria-labelledby="passes">
        <div class="conteneur">
          <h2 id="passes" class="section__titre section__titre--gauche">Événements passés</h2>
          <ul class="liste-simple">
            {passes.map((e) => (
              <li>
                <a href={`/evenements/${e.slug}`}>{e.titre}</a>, <time datetime={e.dateDebut}>{formatDate(e.dateDebut)}</time>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<script>
  import { activerFiltreListe, normaliser } from '../../lib/filtre-liste';

  const formulaire = document.querySelector<HTMLFormElement>('[data-filtre-evenements]');
  const resultats = document.querySelector<HTMLElement>('[data-resultats-evenements]');
  if (formulaire && resultats) {
    resultats.hidden = false;
    activerFiltreListe({
      formulaire,
      elements: [...document.querySelectorAll<HTMLElement>('[data-liste-evenements] > li')],
      resultats,
      unite: ['événement à venir', 'événements à venir'],
      correspond: (li, v) => !v.type || normaliser(li.dataset.type ?? '') === v.type,
    });
  }
</script>
