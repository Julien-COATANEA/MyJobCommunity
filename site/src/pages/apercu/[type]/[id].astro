---
// Aperçu d'un brouillon depuis le BO (bouton « Aperçu » de Strapi) : seule page rendue à la demande.
// Protégée par le secret partagé APERCU_SECRET, jamais indexée, exclue du plan de site.
export const prerender = false;

import Base from '../../../layouts/Base.astro';
import VueAccueil from '../../../components/vues/VueAccueil.astro';
import VuePage from '../../../components/vues/VuePage.astro';
import VueArticle from '../../../components/vues/VueArticle.astro';
import VueEvenement from '../../../components/vues/VueEvenement.astro';
import VueEntreprise from '../../../components/vues/VueEntreprise.astro';
import { lireOffresEntreprise } from '../../../lib/contenus';
import { PUBLIC_STRAPI_URL, lireBrouillon } from '../../../lib/strapi';
import { resoudreGabarit } from '../../../lib/gabarits';
import { jetonEssaiValide } from '../../../lib/essai-gabarit';

const TYPES: Record<string, { api: string; unique: boolean }> = {
  accueil: { api: 'accueil', unique: true },
  page: { api: 'pages', unique: false },
  article: { api: 'articles', unique: false },
  evenement: { api: 'evenements', unique: false },
  entreprise: { api: 'entreprises', unique: false },
};

const { type = '', id = '' } = Astro.params;
const secret = process.env.APERCU_SECRET;
// Essai d'un template depuis « Apparence » : jeton signé par le BO, qui n'ouvre que l'accueil publié (jamais un brouillon).
const essaiSigne = type === 'accueil' && jetonEssaiValide(Astro.url.searchParams.get('essai'), id, secret);
if (!secret || (!essaiSigne && Astro.url.searchParams.get('secret') !== secret)) {
  return new Response('Aperçu non autorisé.', { status: 403 });
}
const definition = TYPES[type];
if (!definition) return new Response('Type de contenu inconnu.', { status: 404 });

const statut = essaiSigne || Astro.url.searchParams.get('statut') === 'published' ? 'published' : 'draft';
// Dans l'aperçu intégré au BO, un clic sur un texte ouvre son champ (désactivable avec ?visuel=0).
const edition = !essaiSigne && Astro.url.searchParams.get('visuel') !== '0';
const doc: any = await lireBrouillon(definition.api, id, statut, definition.unique, edition);
if (!doc) return new Response('Contenu introuvable.', { status: 404 });

// Essai d'un template depuis « Apparence » du BO (?gabarit=vitrine&reglages={…}) : rien n'est enregistré, Base.astro
// et les composants utilisent ce template au lieu de celui du site. Valeurs inconnues ignorées (voir resoudreGabarit).
const essai = Astro.url.searchParams.get('gabarit');
if (essai) {
  let reglages: unknown = null;
  try {
    reglages = JSON.parse(Astro.url.searchParams.get('reglages') ?? 'null');
  } catch {
    // Réglages illisibles : ceux par défaut du template.
  }
  Astro.locals.gabarit = resoudreGabarit({ gabarit: essai, reglagesGabarits: { [essai]: reglages } });
}

const offresEntreprise = type === 'entreprise' ? await lireOffresEntreprise(doc.slug) : { offres: [], total: 0 };
const titre = doc.titre ?? doc.nom ?? doc.heroTitre ?? 'Aperçu';
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const originesBO = [PUBLIC_STRAPI_URL];
---

<Base titre={`Aperçu : ${titre}`} noIndex sansSuivi>
  <div class="bandeau-apercu" role="status">
    {
      essai
        ? 'Essai d’un template : le site en ligne n’a pas changé.'
        : statut === 'draft'
          ? 'Aperçu du brouillon : cette version n’est pas encore publiée.'
          : 'Aperçu de la version publiée.'
    }
  </div>
  {type === 'accueil' && <VueAccueil accueil={doc} />}
  {type === 'page' && <VuePage page={doc} />}
  {type === 'article' && <VueArticle article={doc} />}
  {type === 'evenement' && <VueEvenement evenement={doc} apercu />}
  {type === 'entreprise' && <VueEntreprise entreprise={doc} offres={offresEntreprise.offres} nbOffres={offresEntreprise.total} />}
</Base>

<script is:inline define:vars={{ originesBO }}>
  // Dialogue avec l'aperçu du back-office : le BO envoie son script d'édition visuelle (surbrillance au survol,
  // double-clic pour modifier) et signale chaque enregistrement pour que la page se recharge.
  window.addEventListener('message', (evenement) => {
    if (!originesBO.includes(evenement.origin)) return;
    const message = evenement.data;
    if (message?.type === 'strapiScript') {
      const script = document.createElement('script');
      script.textContent = message.payload.script;
      document.head.appendChild(script);
    }
    if (message?.type === 'strapiUpdate') location.reload();
  });
  if (window.parent !== window) window.parent.postMessage({ type: 'previewReady' }, '*');
</script>
