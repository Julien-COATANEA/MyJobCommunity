---
// Détail d'une offre : page statique indexable + données structurées JobPosting (Google for Jobs).
// La candidature se fait sur le site Gestmax (lien /apply/...).
import sanitizeHtml from 'sanitize-html';
import Base from '../../layouts/Base.astro';
import EnTetePage from '../../components/EnTetePage.astro';
import Icone from '../../components/Icone.astro';
import CarteOffre from '../../components/cartes/CarteOffre.astro';
import BanniereOffre from '../../components/BanniereOffre.astro';
import { lireComptesParEntreprise, lireOffreComplete, lireOffres, lirePageOffres, lireParametres, lireSimilaires, type Offre, type OffreLegere } from '../../lib/contenus';
import { classeContrat, formatDate, ilYA } from '../../lib/format';
import { lienSur } from '../../lib/liens';

// 90 000 offres : chaque page ne reçoit que des données légères (trois offres similaires, un compteur, le rang qui
// indique où lire sa fiche complète) ; calculs en O(1) par offre, fiche complète lue par pages d'API au moment du rendu.
export async function getStaticPaths() {
  const [offres, similaires, comptes] = await Promise.all([lireOffres(), lireSimilaires(), lireComptesParEntreprise()]);
  // Ordre de `rang` (celui des pages d'API des fiches complètes) : chaque page d'API n'est lue qu'une fois, et la lecture
  // en avance de la suivante sert vraiment. L'ordre d'affichage (à la une, date) ne compte pas ici.
  return [...offres].sort((a, b) => a.rang - b.rang).map((offre) => ({
    params: { slug: offre.slug },
    props: {
      offreLegere: offre,
      rang: offre.rang,
      similaires: similaires(offre),
      nbOffresEntreprise: offre.nomEntreprise ? (comptes.get(offre.nomEntreprise) ?? 0) : 0,
    },
  }));
}

const { offreLegere, rang, similaires, nbOffresEntreprise } = Astro.props as { offreLegere: OffreLegere; rang: number; similaires: OffreLegere[]; nbOffresEntreprise: number };
// Offre retirée de Strapi pendant le build : la page est générée avec les données légères plutôt que de faire échouer
// tout le build (elle disparaîtra au build suivant).
const o: Offre = (await lireOffreComplete(Astro.params.slug!, rang)) ?? ({ ...offreLegere, descriptionHtml: null, profilHtml: null } as unknown as Offre);
const [parametres, pageOffres] = await Promise.all([lireParametres(), lirePageOffres()]);
const banniere = pageOffres?.imageBandeauOffre ?? null;
// Adresses venues de Gestmax (application_link, logo) : protocoles autorisés seulement.
const urlCandidature = lienSur(o.urlCandidature);
const logoUrl = lienSur(o.logoUrl);
const urlDetailGestmax = lienSur(o.urlDetailGestmax);
const ariane = [{ libelle: "Offres d'emploi", url: '/offres/' }, { libelle: o.titre }];

// Le HTML vient de Gestmax : on ne garde que les balises de mise en forme.
const nettoyer = (html: string | null) =>
  html
    ? sanitizeHtml(html, {
        allowedTags: ['p', 'br', 'ul', 'ol', 'li', 'strong', 'b', 'em', 'i', 'a', 'h3', 'h4'],
        allowedAttributes: { a: ['href'] },
        transformTags: { h1: 'h3', h2: 'h3' },
      })
    : '';
const description = nettoyer(o.descriptionHtml);
const profil = nettoyer(o.profilHtml);
const texteBrut = sanitizeHtml(o.descriptionHtml ?? '', { allowedTags: [], allowedAttributes: {} }).replace(/\s+/g, ' ').trim();
// Sans description (champ non renseigné dans Gestmax), la méta-description reprend les informations de l'offre.
const resume = [o.titre, o.nomEntreprise && `chez ${o.nomEntreprise}`, o.lieu && `à ${o.lieu}`, o.typeContrat && `(${o.typeContrat})`].filter(Boolean).join(' ');
const avertissement = `Vous allez postuler sur l'espace candidat de ${parametres.nomSite} : votre candidature sera transmise directement au recruteur.`;

const TYPES_EMPLOI: Record<string, string> = {
  CDI: 'FULL_TIME', CDD: 'TEMPORARY', Intérim: 'TEMPORARY', Saisonnier: 'TEMPORARY',
  Stage: 'INTERN', Alternance: 'OTHER', Apprentissage: 'OTHER', 'Temps partiel': 'PART_TIME',
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: o.titre,
  description: `${description}${profil}` || o.titre,
  identifier: { '@type': 'PropertyValue', name: o.nomEntreprise ?? parametres.nomSite, value: o.sourceId },
  ...(o.dateActivation ? { datePosted: o.dateActivation } : {}),
  ...(o.dateFinPublication ? { validThrough: o.dateFinPublication } : {}),
  ...(o.typeContrat && TYPES_EMPLOI[o.typeContrat] ? { employmentType: TYPES_EMPLOI[o.typeContrat] } : {}),
  hiringOrganization: {
    '@type': 'Organization',
    name: o.nomEntreprise ?? parametres.nomSite,
    ...(logoUrl ? { logo: logoUrl } : {}),
    ...(o.entreprise ? { sameAs: new URL(`/entreprises/${o.entreprise.slug}/`, Astro.site).toString() } : {}),
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      ...(o.lieu ? { addressLocality: o.lieu } : {}),
      ...(o.departement ? { addressRegion: o.departement } : {}),
      addressCountry: 'FR',
    },
    ...(o.latitude != null ? { geo: { '@type': 'GeoCoordinates', latitude: o.latitude, longitude: o.longitude } } : {}),
  },
  directApply: false,
};
---

<Base titre={`${o.titre}${o.lieu ? ` à ${o.lieu}` : ''}`} description={texteBrut.slice(0, 155) || resume} jsonLd={[jsonLd]} ariane={ariane}>
  {
    banniere ? (
      <BanniereOffre media={banniere} ariane={ariane}>
        <a href="/offres/" class="banniere-offre__retour" data-retour-resultats><Icone nom="retour" taille={18} />Retour aux offres</a>
      </BanniereOffre>
    ) : (
      <div class="conteneur retour-resultats">
        <a href="/offres/" data-retour-resultats><Icone nom="retour" taille={18} />Retour aux offres</a>
      </div>
    )
  }

  <EnTetePage titre={o.titre} surtitre={o.nomEntreprise} variante="clair">
    <p class="offre__badges offre__badges--entete">
      {o.typeContrat && <span class={`badge-contrat badge-contrat--${classeContrat(o.typeContrat)}`}>{o.typeContrat}</span>}
    </p>
    <ul class="meta meta--entete">
      {o.lieu && <li><Icone nom="lieu" taille={20} />{o.lieu}{o.departement && o.departement !== o.lieu ? `, ${o.departement}` : ''}</li>}
      {o.salaire && <li><Icone nom="euro" taille={20} />{o.salaire}</li>}
      {o.dateActivation && <li><Icone nom="horloge" taille={20} /><time datetime={o.dateActivation}>Publiée {ilYA(o.dateActivation)}</time></li>}
    </ul>
  </EnTetePage>

  <div class="conteneur evenement">
    <div class="evenement__contenu prose">
      {description && <><h2>Le poste</h2><Fragment set:html={description} /></>}
      {profil && <><h2>Le profil recherché</h2><Fragment set:html={profil} /></>}
      {
        !description && !profil && (
          <p>
            Cette offre n'a pas de descriptif détaillé.{urlDetailGestmax ? <> <a href={urlDetailGestmax}>Consulter l'annonce d'origine</a>.</> : ' Les modalités de candidature sont indiquées avec le bouton « Postuler ».'}
          </p>
        )
      }
    </div>
    <aside class="evenement__infos" aria-labelledby="postuler">
      <h2 id="postuler">Postuler</h2>
      {
        urlCandidature ? (
          <>
            <p>
              <a href={urlCandidature} class="bouton bouton--accent bouton--large" aria-describedby="avertissement-candidature">
                Postuler à cette offre
                <Icone nom="externe" taille={18} />
              </a>
            </p>
            <p class="petit" id="avertissement-candidature">{avertissement}</p>
          </>
        ) : (
          <p>Les modalités de candidature figurent dans l'offre.</p>
        )
      }
      {o.dateFinPublication && <p class="petit">Offre en ligne jusqu'au {formatDate(o.dateFinPublication)}.</p>}

      {
        o.nomEntreprise && (
          <div class="encart-entreprise">
            {logoUrl ? <img src={logoUrl} alt="" width="56" height="56" class="encart-entreprise__logo" loading="lazy" /> : null}
            <div>
              <p class="encart-entreprise__nom">{o.nomEntreprise}</p>
              <ul class="encart-entreprise__liens">
                {o.entreprise && <li><a href={`/entreprises/${o.entreprise.slug}/`}>Découvrir l'entreprise</a></li>}
                {nbOffresEntreprise > 1 && (
                  <li><a href={`/offres/?entreprise=${encodeURIComponent(o.nomEntreprise)}`}>Voir ses {nbOffresEntreprise} offres</a></li>
                )}
              </ul>
            </div>
          </div>
        )
      }
    </aside>
  </div>

  {
    similaires.length > 0 && (
      <section class="section section--teinte" aria-labelledby="offres-similaires">
        <div class="conteneur">
          <h2 id="offres-similaires" class="section__titre section__titre--gauche">Offres similaires</h2>
          <ul class="grille grille--3">
            {similaires.map((s) => <li><CarteOffre offre={s} /></li>)}
          </ul>
        </div>
      </section>
    )
  }

  {
    urlCandidature && (
      <div class="barre-postuler">
        <span class="barre-postuler__titre">{o.titre}</span>
        <a href={urlCandidature} class="bouton bouton--accent" aria-describedby="avertissement-candidature">Postuler</a>
      </div>
    )
  }
</Base>

<script>
  // « Retour aux offres » ramène à la dernière recherche (filtres compris).
  try {
    const recherche = sessionStorage.getItem('mjc-derniere-recherche');
    const lien = document.querySelector<HTMLAnchorElement>('[data-retour-resultats]');
    if (lien && recherche !== null) {
      lien.href = `/offres/${recherche ? `?${recherche}` : ''}`;
      lien.lastChild!.textContent = 'Retour aux résultats';
    }
  } catch {}
</script>
