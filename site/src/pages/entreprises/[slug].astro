---
import Base from '../../layouts/Base.astro';
import VueEntreprise from '../../components/vues/VueEntreprise.astro';
import { lireEntreprises, type Entreprise } from '../../lib/contenus';
import { urlMedia } from '../../lib/strapi';
import { lienSur } from '../../lib/liens';

// Les offres de chaque entreprise (les plus récentes et leur nombre) sont déjà dans la fiche : voir lireEntreprises.
export async function getStaticPaths() {
  const entreprises = await lireEntreprises();
  return entreprises.map((entreprise) => ({ params: { slug: entreprise.slug }, props: { entreprise } }));
}

const { entreprise: e } = Astro.props as { entreprise: Entreprise };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: e.nom,
  description: e.extrait,
  ...(lienSur(e.siteWeb) ? { url: lienSur(e.siteWeb) } : {}),
  ...(e.logo ? { logo: urlMedia(e.logo, true) } : {}),
  address: { '@type': 'PostalAddress', addressLocality: e.ville, ...(e.adresse ? { streetAddress: e.adresse } : {}), addressCountry: 'FR' },
};
---

<Base titre={e.nom} description={e.extrait} seo={e.seo} image={urlMedia(e.image ?? e.logo, true)} jsonLd={[jsonLd]} ariane={[{ libelle: 'Entreprises', url: '/entreprises/' }, { libelle: e.nom }]}>
  <VueEntreprise entreprise={e} offres={e.offres} nbOffres={e.nbOffres} />
</Base>
