---
// Pied de page (maquette) : marque + réseaux sociaux, liens utiles, contact, barre légale, mention « propulsé par ».
// Repris aussi par le site Gestmax (voir shell.css).
import Icone from './Icone.astro';
import { lirePages, type Navigation, type Parametres } from '../lib/contenus';
import { liensLegauxParDefaut } from '../lib/pages-legales';
import { absolu, resoudreLien } from '../lib/liens';
import { urlMedia } from '../lib/strapi';
import { resoudreGabarit } from '../lib/gabarits';
import { initiales } from '../lib/format';
import { LOGOS_RESEAUX, NOMS_RESEAUX, reseauxSurs } from '../lib/reseaux';

interface Props {
  parametres: Parametres;
  navigation: Navigation;
  base?: string;
  /** Bouton « Gestion des cookies » (rouvre le bandeau ; absent de l'habillage Gestmax, sans scripts). */
  gestionCookies?: boolean;
}

const { parametres, navigation, base, gestionCookies } = Astro.props;
const lien = (url: string) => absolu(resoudreLien(url, parametres.gestmaxUrlFront), base);
// Liens sans adresse valide (vide, protocole refusé) écartés.
const avecLien = <T extends { url: string }>(liens: T[]) => liens.map((l) => ({ ...l, href: lien(l.url) })).filter((l) => l.href);
const liensUtiles = avecLien(navigation.liensPiedDePage);
// Sans liens légaux saisis dans le BO : les pages légales publiées (jamais un brouillon, qui serait en 404).
const liensLegaux = avecLien(navigation.liensLegaux?.length ? navigation.liensLegaux : liensLegauxParDefaut(await lirePages()));
const reseaux = reseauxSurs(parametres.reseauxSociaux);
const logo = urlMedia(parametres.logo, true);
const gabarit = Astro.locals.gabarit ?? resoudreGabarit(parametres);
const description = parametres.seoParDefaut?.metaDescription;
const annee = new Date().getFullYear();
---

<div class="mjc-shell" {...gabarit.attributs}>
<footer class="pied">
  <div class="conteneur">
    <div class="pied__grille">
      <div class="pied__identite">
        <a href={absolu('/', base)} class="pied__marque">
          {
            logo ? (
              <img class="pied__logo" src={logo} alt="" width="42" height="42" />
            ) : (
              <span class="marque__pastille" aria-hidden="true">{parametres.logoTexte ?? initiales(parametres.nomSite, 3)}</span>
            )
          }
          <span class="pied__nom">
            {parametres.nomSite}
            {parametres.baseline && <small>{parametres.baseline}</small>}
          </span>
          <span class="sr-only">, retour à l'accueil</span>
        </a>
        {description && <p class="pied__description">{description}</p>}
        {
          reseaux.length > 0 && (
            <ul class="pied__reseaux" aria-label="Nos réseaux sociaux">
              {reseaux.map((r) => (
                <li>
                  <a href={r.url} rel="me noopener" aria-label={NOMS_RESEAUX[r.reseau] ?? r.reseau}>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d={LOGOS_RESEAUX[r.reseau] ?? LOGOS_RESEAUX.facebook} />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        liensUtiles.length > 0 && (
          <nav class="pied__nav" aria-labelledby="pied-titre-liens">
            <h2 id="pied-titre-liens" class="pied__titre">Liens utiles</h2>
            <ul>
              {liensUtiles.map((l) => (
                <li><a href={l.href}>{l.libelle}</a></li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        (parametres.adresse || parametres.telephone || parametres.email) && (
          <div class="pied__contact">
            <h2 class="pied__titre">Nous contacter</h2>
            <ul>
              {parametres.adresse && <li><Icone nom="lieu" taille={18} /><address>{parametres.adresse}</address></li>}
              {parametres.telephone && <li><Icone nom="telephone" taille={18} /><a href={`tel:${parametres.telephone.replace(/\s/g, '')}`}>{parametres.telephone}</a></li>}
              {parametres.email && <li><Icone nom="email" taille={18} /><a href={`mailto:${parametres.email}`}>{parametres.email}</a></li>}
            </ul>
          </div>
        )
      }
    </div>

    <div class="pied__legal">
      <p class="pied__copyright">© {annee} {parametres.nomSite}. Tous droits réservés.</p>
      <ul>
        {liensLegaux.map((l) => <li><a href={l.href}>{l.libelle}</a></li>)}
        {/* Révélé par le script du bandeau : sans JavaScript, le bouton ne servirait à rien. */}
        {gestionCookies && <li hidden><button type="button" class="pied__cookies" data-mjc-cookies-ouvrir>Gestion des cookies</button></li>}
      </ul>
    </div>
  </div>
</footer>
<div class="pied__propulse">
  <span>Plateforme emploi propulsée par</span>
  <span class="pied__propulse-marque"><span class="pied__propulse-pastille" aria-hidden="true">MJC</span><strong>My Job Community</strong></span>
</div>
</div>
