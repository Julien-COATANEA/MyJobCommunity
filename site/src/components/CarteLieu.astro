---
// Plan d'accès d'un lieu (maquette « fiche événement ») : mini-carte (fond Plan IGN) si l'adresse est trouvée par le
// géocodeur de l'IGN au build, et toujours un lien vers OpenStreetMap pour l'itinéraire (même sans JavaScript).
import { geocoder } from '../lib/geocodage';

interface Props {
  adresse: string;
}

const { adresse } = Astro.props;
const position = await geocoder(adresse);
const lienPlan = `https://www.openstreetmap.org/search?query=${encodeURIComponent(adresse)}`;
---

<div class="carte-lieu">
  {
    position && (
      <div
        class="carte-lieu__carte"
        role="region"
        aria-label={`Plan d'accès : ${adresse}`}
        data-plan-lieu={adresse}
        data-lat={position.latitude}
        data-lon={position.longitude}
      />
    )
  }
  <p class="carte-lieu__lien">
    <a href={lienPlan} target="_blank" rel="noopener">Voir le plan et l'itinéraire<span class="sr-only"> (OpenStreetMap, nouvelle fenêtre)</span></a>
  </p>
</div>

<script>
  const conteneurs = document.querySelectorAll<HTMLElement>('[data-plan-lieu]');
  if (conteneurs.length) {
    import('../lib/carte-lieu').then(({ afficherLieu }) => {
      for (const c of conteneurs) afficherLieu(c, Number(c.dataset.lat), Number(c.dataset.lon), c.dataset.planLieu!);
    });
  }
</script>
