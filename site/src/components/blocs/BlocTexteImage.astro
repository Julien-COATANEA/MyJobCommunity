---
import ImageStrapi from '../ImageStrapi.astro';
import Bouton from '../Bouton.astro';
import { rendreBlocks } from '../../lib/blocks';
import { PUBLIC_STRAPI_URL } from '../../lib/strapi';

const { bloc } = Astro.props;
---

<section class="section">
  <div class:list={['conteneur', 'texte-image', { 'texte-image--inverse': bloc.positionImage === 'gauche' }]}>
    <div class="texte-image__texte">
      {bloc.titre && <h2 class="section__titre section__titre--gauche">{bloc.titre}</h2>}
      <div class="prose" set:html={rendreBlocks(bloc.contenu, { baseMedias: PUBLIC_STRAPI_URL })} />
      {bloc.bouton && <p><Bouton bouton={bloc.bouton} /></p>}
    </div>
    <div class="texte-image__image">
      <ImageStrapi media={bloc.image} largeurs={[480, 800, 1100]} sizes="(min-width: 960px) 560px, 100vw" />
    </div>
  </div>
</section>
