---
import TitreSection from '../TitreSection.astro';
import ImageStrapi from '../ImageStrapi.astro';

const { bloc } = Astro.props;
---

<section class="section section--teinte">
  <div class="conteneur">
    <TitreSection surtitre={bloc.surtitre} titre={bloc.titre} introduction={bloc.introduction} />
    <ul class="logos">
      {
        bloc.logos.map((l: any) => {
          // L'alternative d'un logo-lien est le nom du partenaire (RGAA 1.3).
          const media = { ...l.image, alternativeText: l.nom };
          return (
            <li class="logos__item">
              {l.url ? (
                <a href={l.url}>
                  <ImageStrapi media={media} largeurs={[200, 320]} sizes="160px" />
                </a>
              ) : (
                <ImageStrapi media={media} largeurs={[200, 320]} sizes="160px" />
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
