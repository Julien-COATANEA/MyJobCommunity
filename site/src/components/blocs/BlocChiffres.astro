---
// {offres}, {entreprises}, {recrutent} et {evenements} sont remplacés par les chiffres réels à chaque mise à jour du site.
import TitreSection from '../TitreSection.astro';
import { lireCompteurs, remplacerCompteurs } from '../../lib/contenus';

const { bloc } = Astro.props;
const compteurs = await lireCompteurs();
---

<section class="section section--chiffres">
  <div class="conteneur">
    <TitreSection surtitre={bloc.surtitre} titre={bloc.titre} introduction={bloc.introduction} />
    <ul class="chiffres">
      {
        bloc.chiffres.map((c: { valeur: string; libelle: string }) => (
          <li class="chiffre">
            <span class="chiffre__valeur">{remplacerCompteurs(c.valeur, compteurs)}</span>
            <span class="chiffre__libelle">{c.libelle}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
