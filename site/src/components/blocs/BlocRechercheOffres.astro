---
import TitreSection from '../TitreSection.astro';
import RechercheOffres from '../RechercheOffres.astro';

const { bloc, index } = Astro.props;
---

<section class="section section--teinte">
  <div class="conteneur">
    <TitreSection surtitre={bloc.surtitre} titre={bloc.titre} introduction={bloc.texte} />
    <RechercheOffres id={`recherche-bloc-${index}`} />
  </div>
</section>
