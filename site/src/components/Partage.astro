---
// Boutons de partage (maquette « Partager ») : LinkedIn, Facebook, X, e-mail et « Copier le lien ».
// De simples liens : aucun script ni cookie de réseau social n'est chargé.
import Icone from './Icone.astro';
import { LOGOS_RESEAUX, liensPartage } from '../lib/reseaux';

interface Props {
  titre: string;
  /** Adresse publique de la page partagée (pas celle de l'aperçu des brouillons). */
  chemin: string;
}

const { titre, chemin } = Astro.props;
const url = new URL(chemin, Astro.site).toString();
const courriel = `mailto:?subject=${encodeURIComponent(titre)}&body=${encodeURIComponent(url)}`;
---

<div class="partage" data-partage>
  <p class="partage__titre" id="partage-titre">Partager</p>
  <ul class="partage__liens" aria-labelledby="partage-titre">
    {
      liensPartage(url, titre).map((l) => (
        <li>
          <a href={l.href} target="_blank" rel="noopener" aria-label={`Partager sur ${l.libelle} (nouvelle fenêtre)`}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d={LOGOS_RESEAUX[l.reseau]} /></svg>
          </a>
        </li>
      ))
    }
    <li>
      <a href={courriel} aria-label="Partager par e-mail"><Icone nom="email" taille={18} /></a>
    </li>
    <li>
      <button type="button" data-copier={url} aria-label="Copier le lien de la page" hidden><Icone nom="lien" taille={18} /></button>
    </li>
  </ul>
  <p class="partage__retour" role="status" data-copie></p>
</div>

<script>
  // « Copier le lien » : seulement si le navigateur le permet (bouton masqué sinon).
  for (const bloc of document.querySelectorAll<HTMLElement>('[data-partage]')) {
    const bouton = bloc.querySelector<HTMLButtonElement>('[data-copier]');
    const retour = bloc.querySelector<HTMLElement>('[data-copie]')!;
    if (!bouton || !navigator.clipboard) continue;
    bouton.hidden = false;
    bouton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(bouton.dataset.copier!);
        retour.textContent = 'Lien copié.';
      } catch {
        retour.textContent = 'Le lien n’a pas pu être copié.';
      }
      setTimeout(() => (retour.textContent = ''), 3000);
    });
  }
</script>
