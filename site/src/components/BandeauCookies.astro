---
// Bandeau de consentement aux cookies, affiché dès qu'un outil de mesure attend l'accord du visiteur (voir lib/suivi.ts). « Tout accepter » et « Tout refuser »
// ont le même poids (recommandation CNIL) ; le choix est conservé 6 mois dans le navigateur. Après accord, les
// <template data-mjc-suivi> écrits par Base.astro sont transformés en vrais scripts. Placé en tête du <body> pour
// être atteint en premier au clavier et par les lecteurs d'écran.
import { lirePages } from '../lib/contenus';
import { resoudreLien } from '../lib/liens';
import { lienPolitiqueCookiesEffectif } from '../lib/pages-legales';
import { TEXTE_BANDEAU } from '../lib/suivi';

interface Props {
  texte?: string | null;
  lien?: string | null;
  gestmaxUrlFront?: string | null;
}

const { texte, lien, gestmaxUrlFront } = Astro.props;
// Sans lien dans le BO : la politique de cookies, si cette page est publiée.
const lienEffectif = lienPolitiqueCookiesEffectif(lien, await lirePages());
const href = lienEffectif ? resoudreLien(lienEffectif, gestmaxUrlFront) : null;
---

<section id="mjc-cookies" class="cookies" aria-labelledby="mjc-cookies-titre" hidden>
  <div class="cookies__contenu">
    <h2 id="mjc-cookies-titre" class="cookies__titre">Gestion des cookies</h2>
    <p class="cookies__texte">
      {texte?.trim() || TEXTE_BANDEAU}
      {href && <> <a href={href}>En savoir plus</a></>}
    </p>
  </div>
  <div class="cookies__actions">
    <button type="button" class="bouton bouton--plein bouton--petit" data-mjc-cookies="non">Tout refuser</button>
    <button type="button" class="bouton bouton--plein bouton--petit" data-mjc-cookies="oui">Tout accepter</button>
  </div>
</section>

<script is:inline>
  (() => {
    const CLE = 'mjc-cookies';
    const DUREE = 182 * 24 * 3600 * 1000;
    const bandeau = document.getElementById('mjc-cookies');
    if (!bandeau) return;

    const lire = () => {
      try {
        const v = JSON.parse(localStorage.getItem(CLE) || 'null');
        return v && Date.now() - v.date < DUREE ? v.choix : null;
      } catch {
        return null;
      }
    };
    const ecrire = (choix) => {
      try {
        localStorage.setItem(CLE, JSON.stringify({ choix, date: Date.now() }));
      } catch {
        // Stockage indisponible : le bandeau réapparaîtra à la prochaine page.
      }
    };

    // Un <script> copié depuis un <template> ne s'exécute pas : on le recrée.
    const recreer = (ancien) => {
      const s = document.createElement('script');
      for (const a of ancien.attributes) s.setAttribute(a.name, a.value);
      if (ancien.src && !ancien.hasAttribute('async')) s.async = false;
      s.text = ancien.textContent;
      return s;
    };
    let actifs = false;
    const activer = () => {
      if (actifs) return;
      actifs = true;
      document.querySelectorAll('template[data-mjc-suivi]').forEach((t) => {
        const cible = t.dataset.mjcSuivi === 'head' ? document.head : document.body;
        for (const noeud of Array.from(t.content.childNodes)) {
          if (noeud.nodeName === 'SCRIPT') {
            cible.appendChild(recreer(noeud));
            continue;
          }
          const copie = noeud.cloneNode(true);
          if (copie.querySelectorAll) copie.querySelectorAll('script').forEach((s) => s.replaceWith(recreer(s)));
          cible.appendChild(copie);
        }
      });
    };

    // Retrait du consentement : cookies Google Analytics effacés (domaine courant et domaines parents).
    const effacerCookies = () => {
      const noms = document.cookie.split(';').map((c) => c.split('=')[0].trim()).filter((n) => n === '_ga' || n === '_gid' || n.startsWith('_ga_'));
      const parties = location.hostname.split('.');
      const domaines = [''];
      for (let i = 0; i < parties.length - 1; i++) domaines.push(`; domain=.${parties.slice(i).join('.')}`);
      for (const nom of noms) for (const d of domaines) document.cookie = `${nom}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${d}`;
    };

    // Bouton « Gestion des cookies » du pied de page (plus bas dans la page) : masqué sans JavaScript.
    // Idem pour le bouton « Gérer mes choix » du bloc « Cookies utilisés » d'une page.
    const montrerGestion = () => {
      document.querySelectorAll('[data-mjc-cookies-ouvrir]').forEach((b) => {
        b.hidden = false;
        const li = b.closest('li');
        if (li) li.hidden = false;
      });
    };

    let rouvertPar = null;
    const ouvrir = (bouton) => {
      rouvertPar = bouton;
      bandeau.hidden = false;
      bandeau.querySelector('button')?.focus();
    };
    bandeau.addEventListener('click', (e) => {
      const choix = e.target.closest?.('[data-mjc-cookies]')?.dataset.mjcCookies;
      if (!choix) return;
      ecrire(choix);
      // Le focus ne doit pas se perdre avec le bandeau masqué : retour au bouton « Gestion des cookies » qui l'a
      // rouvert, sinon début du contenu (sans faire défiler la page).
      if (rouvertPar?.isConnected) rouvertPar.focus();
      else document.getElementById('contenu')?.focus({ preventScroll: true });
      bandeau.hidden = true;
      if (choix === 'oui') activer();
      else {
        effacerCookies();
        // Des outils déjà lancés ne s'arrêtent pas : on recharge la page sans eux.
        if (actifs) location.reload();
      }
    });
    document.addEventListener('click', (e) => {
      const bouton = e.target.closest?.('[data-mjc-cookies-ouvrir]');
      if (bouton) ouvrir(bouton);
    });

    // Le bandeau est en haut de page : le pied et les <template> de fin de page ne sont pas encore lus.
    const quandPret = (f) => (document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', f) : f());
    quandPret(montrerGestion);
    const choix = lire();
    if (!choix) bandeau.hidden = false;
    else if (choix === 'oui') quandPret(activer);
  })();
</script>
