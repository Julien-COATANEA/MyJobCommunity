---
// Carte d'actualité (maquette) : image avec la catégorie posée dessus, date, titre, résumé, « Lire l'article ».
import ImageStrapi from '../ImageStrapi.astro';
import Icone from '../Icone.astro';
import type { Article } from '../../lib/contenus';
import { formatDate } from '../../lib/format';

interface Props {
  article: Article;
  niveauTitre?: 2 | 3;
}

const { article, niveauTitre = 3 } = Astro.props;
const Titre = `h${niveauTitre}`;
---

<article class="carte">
  {
    article.image && (
      <div class="carte__visuel">
        <ImageStrapi media={article.image} largeurs={[400, 700]} sizes="(min-width: 960px) 380px, 100vw" decorative />
        {article.categorie && <p class="etiquette">{article.categorie.nom}</p>}
      </div>
    )
  }
  <div class="carte__corps">
    {!article.image && article.categorie && <p class="etiquette">{article.categorie.nom}</p>}
    <p class="carte__date"><time datetime={article.datePublication}>{formatDate(article.datePublication)}</time></p>
    <Titre class="carte__titre">
      <a href={`/actualites/${article.slug}`} class="carte__lien">{article.titre}</a>
    </Titre>
    <p class="carte__texte">{article.extrait}</p>
    <p class="carte__pied"><span class="lien-action" aria-hidden="true">Lire l'article<Icone nom="fleche" taille={16} /></span></p>
  </div>
</article>
