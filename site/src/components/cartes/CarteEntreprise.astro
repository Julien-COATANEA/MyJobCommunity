---
import Icone from '../Icone.astro';
import ImageStrapi from '../ImageStrapi.astro';
import type { Entreprise } from '../../lib/contenus';
import { initiales } from '../../lib/format';

interface Props {
  entreprise: Entreprise;
  niveauTitre?: 2 | 3;
}

const { entreprise: e, niveauTitre = 3 } = Astro.props;
const Titre = `h${niveauTitre}`;
const nbOffres = e.offres?.length ?? 0;
const lettres = initiales(e.nom);
const lienOffres = e.nomEntiteGestmax ? `/offres?entreprise=${encodeURIComponent(e.nomEntiteGestmax)}` : null;
---

<article class="carte carte--entreprise" data-secteur={e.secteur?.slug ?? ''} data-nom={e.nom.toLowerCase()}>
  {
    e.image && (
      <div class="carte__visuel">
        <ImageStrapi media={e.image} largeurs={[400, 700]} sizes="(min-width: 960px) 380px, 100vw" decorative />
      </div>
    )
  }
  <div class="carte__corps">
    <div class="entreprise__identite">
      {
        e.logo ? (
          <ImageStrapi media={{ ...e.logo, alternativeText: '' }} class="entreprise__vignette" largeurs={[112]} sizes="56px" />
        ) : (
          <span class="entreprise__vignette entreprise__vignette--initiales" aria-hidden="true">{lettres}</span>
        )
      }
      <div>
        {e.secteur && <p class="etiquette">{e.secteur.nom}</p>}
        <Titre class="carte__titre">
          <a href={`/entreprises/${e.slug}`} class="carte__lien">{e.nom}</a>
        </Titre>
      </div>
    </div>
    <p class="carte__texte">{e.extrait}</p>
    <ul class="meta">
      <li><Icone nom="lieu" taille={18} />{e.ville}</li>
      {e.effectif && <li><Icone nom="famille" taille={18} />{e.effectif}</li>}
    </ul>
    {
      nbOffres > 0 && lienOffres && (
        <p class="carte__action">
          <a href={lienOffres} class="lien-fort">
            Voir {nbOffres > 1 ? `ses ${nbOffres} offres` : 'son offre'}
            <span class="sr-only"> chez {e.nom}</span>
            <Icone nom="fleche" taille={16} />
          </a>
        </p>
      )
    }
  </div>
</article>
