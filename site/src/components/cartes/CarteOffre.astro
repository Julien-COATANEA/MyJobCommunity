---
// Le balisage vient de src/lib/carte-offre.ts : identique au rendu des résultats de recherche dans le navigateur.
import { htmlCarteOffre, type OffreCarte, type Masquer } from '../../lib/carte-offre';

interface Props {
  offre: OffreCarte;
  niveauTitre?: 2 | 3;
  masquer?: Masquer;
}

const { offre, niveauTitre = 3, masquer } = Astro.props;
---

<Fragment set:html={htmlCarteOffre(offre, { niveauTitre, masquer })} />
