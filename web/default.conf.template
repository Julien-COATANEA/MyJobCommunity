# Sert la dernière version générée du site statique (lien /srv/site/current, basculé par le builder).
# Modèle : l'image nginx remplace ${HEADER_FOOTER_TOKEN} au démarrage (variable du fichier .env).
# Attention : un add_header dans un bloc location annule ceux du niveau server, d'où les répétitions.

map $uri $cache_control {
    ~^/_astro/   "public, max-age=31536000, immutable";   # fichiers versionnés (empreinte dans le nom)
    # Pages HTML : le navigateur revérifie à chaque visite (réponse 304 légère si rien n'a changé),
    # pour que chaque publication soit visible immédiatement.
    default      "no-cache";
}

server {
    listen 80;
    server_name _;
    root /srv/site/current;
    index index.html;
    charset utf-8;

    # Redirection « /page » vers « /page/ » en adresse relative : une adresse absolue reprendrait le port 80 du
    # conteneur (http://localhost/page/ au lieu de http://localhost:8080/page/) et, derrière un reverse proxy
    # HTTPS, le mauvais protocole.
    absolute_redirect off;

    # Le HTML est toujours compressé ; text/xml : plan du site (sitemap-N.xml, mime.types de Nginx).
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_vary on;
    gzip_types text/plain text/css text/xml application/javascript application/json application/ld+json image/svg+xml application/xml;

    # Des dizaines de milliers de pages (offres/<slug>/index.html) : les descripteurs et les existences de fichiers
    # sont gardés en mémoire. Courte validité : après une publication (lien « current » basculé), l'ancienne page
    # ne reste servie que quelques secondes.
    open_file_cache max=10000 inactive=60s;
    open_file_cache_valid 10s;
    open_file_cache_min_uses 1;
    # Pas de cache des « fichier introuvable » : une page ajoutée par une nouvelle version doit répondre tout de suite.
    open_file_cache_errors off;

    # En-têtes de sécurité, répétés dans chaque location qui a ses propres add_header.
    # CSP minimale qui ne casse rien (scripts de mesure, iframes Gestmax, tuiles IGN restent permis).
    add_header Cache-Control $cache_control always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;

    # Feuilles de style et polices : chargées aussi par le site Gestmax (autre domaine possible).
    location /_astro/ {
        add_header Cache-Control $cache_control always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;
        add_header Access-Control-Allow-Origin "*" always;
        try_files $uri =404;
    }

    # En-tête/pied de page lus par le site Gestmax (plugin HeaderFooterWp) : uniquement avec le jeton.
    location ^~ /header-footer/ {
        if ($arg_token != "${HEADER_FOOTER_TOKEN}") { return 404; }
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri $uri/index.html =404;
    }

    # Fichiers agenda des événements : absents du mime.types de Nginx (servis sinon en application/octet-stream).
    location ~* \.ics$ {
        types { }
        default_type "text/calendar; charset=utf-8";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    error_page 404 /404.html;
}
