{
  "kind": "collectionType",
  "collectionName": "article",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Articles"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "datePublication": {
      "type": "date",
      "required": true
    },
    "categorie": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::categorie-article.categorie-article",
      "inversedBy": "articles"
    },
    "extrait": {
      "type": "text",
      "required": true,
      "maxLength": 300
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "contenu": {
      "type": "blocks",
      "required": true
    },
    "miseEnAvant": {
      "type": "boolean",
      "default": false
    },
    "publierLe": {
      "type": "datetime"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
