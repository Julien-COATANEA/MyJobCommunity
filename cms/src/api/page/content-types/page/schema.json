{
  "kind": "collectionType",
  "collectionName": "page",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Pages",
    "description": "Page libre composée de blocs standardisés"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "chapo": {
      "type": "text"
    },
    "imageBandeau": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "blocs.texte",
        "blocs.texte-image",
        "blocs.chiffres-cles",
        "blocs.cartes",
        "blocs.appel-action",
        "blocs.faq",
        "blocs.logos",
        "blocs.recherche-offres",
        "blocs.dernieres-offres",
        "blocs.dernieres-actualites",
        "blocs.prochains-evenements",
        "blocs.entreprises",
        "blocs.temoignages",
        "blocs.iframe"
      ]
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
