# ============================================================
#  Configuration d'UNE instance My Job Community (un client)
#  Copier en .env puis remplacer les valeurs "change_me".
#  Secret aléatoire : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ============================================================

# --- Base de données (MariaDB) ---
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change_me
DATABASE_ROOT_PASSWORD=change_me

# --- Secrets Strapi ---
APP_KEYS=change_me_1,change_me_2,change_me_3,change_me_4
API_TOKEN_SALT=change_me
ADMIN_JWT_SECRET=change_me
TRANSFER_TOKEN_SALT=change_me
JWT_SECRET=change_me
ENCRYPTION_KEY=change_me

# --- URLs publiques ---
# URL publique du site (canonical, sitemap, JSON-LD, redirections du formulaire d'inscription)
SITE_URL=http://localhost:8080
# URL de Strapi vue par le navigateur (filtres d'offres, inscriptions)
PUBLIC_STRAPI_URL=http://localhost:1337
# Origines autorisées à appeler l'API Strapi depuis le navigateur
CORS_ORIGINS=http://localhost:4321,http://localhost:8080
# production = indexable ; tout autre valeur = robots.txt en Disallow + noindex
SITE_ENV=development

# --- Données de démonstration (au premier démarrage, base vide) ---
SEED_DEMO=true
# Comptes de test du back-office créés si SEED_DEMO=true
# (mot de passe : 8 caractères minimum, avec une majuscule, une minuscule et un chiffre)
DEMO_ADMIN_EMAIL=admin@myjobcommunity.local
DEMO_ADMIN_PASSWORD=change_me
DEMO_EDITEUR_EMAIL=editeur@vallee-verte.local
DEMO_EDITEUR_PASSWORD=change_me

# --- Régénération du site statique (webhook Strapi → builder) ---
BUILD_TOKEN=change_me
# Délai d'attente (ms) après la dernière modification avant de lancer le build
BUILD_DEBOUNCE_MS=3000

# --- Aperçu des brouillons (bouton « Aperçu » du BO) ---
# Secret partagé entre Strapi et la page /apercu du site ; adresse du serveur d'aperçu
APERCU_SECRET=change_me
APERCU_URL=http://localhost:4321

# --- Site carrière Gestmax (plugin HeaderFooterWp) ---
# Jeton exigé pour lire /header-footer/ (à transmettre dans headerFooterWp.url)
HEADER_FOOTER_TOKEN=change_me

# --- Marque blanche du back-office (lu au build de l'admin Strapi) ---
STRAPI_ADMIN_BRAND_NAME=My Job Community
STRAPI_ADMIN_PRIMARY_COLOR=#1a5f7a
# Adresse affichée dans la page « Aide » du back-office (facultatif)
STRAPI_ADMIN_SUPPORT_EMAIL=

# --- E-mails (inscriptions aux événements) ---
SMTP_FROM=no-reply@myjobcommunity.local
SMTP_REPLY_TO=contact@myjobcommunity.local

# --- Gestmax (synchronisation des offres via REST v2 onlinevacancy) ---
# URL du front Gestmax de la collectivité, sans slash final
GESTMAX_URL=
# Utilisateur REST v2 (table rest_user, droits OnlineVacancyList + OnlineVacancyDetails)
GESTMAX_REST_USER=
GESTMAX_REST_PASSWORD=
# Section MultiFront éventuelle (paramètre frontOffice)
GESTMAX_FRONT_OFFICE=
# true = lit cms/data/gestmax-mock.json au lieu d'appeler Gestmax
GESTMAX_MOCK=true
# Fréquence de synchronisation (cron)
GESTMAX_SYNC_CRON=*/30 * * * *
# Correspondance des champs : les noms vac_* diffèrent d'une instance Gestmax à l'autre
# (voir /rest/v2/apidoc sur l'instance)
GESTMAX_FIELD_CONTRAT=vac_contract
GESTMAX_FIELD_LIEU=vac_town
GESTMAX_FIELD_DEPARTEMENT=vac_localisation
GESTMAX_FIELD_SECTEUR=vac_function
GESTMAX_FIELD_DESCRIPTION=vac_tasks
# Facultatif : « Nous vous proposons », ajouté à la suite de la description
GESTMAX_FIELD_AVANTAGES=vac_offer
GESTMAX_FIELD_PROFIL=vac_profil
GESTMAX_FIELD_SALAIRE=vac_salaire
